{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, seq, payload, content_hash, ingested_at, deleted_at\n              FROM record\n             WHERE source = $1\n               AND collection = $2\n               AND deleted_at IS NULL\n               AND seq > $3\n               AND payload @> $5\n             ORDER BY seq\n             LIMIT $4\n            ",

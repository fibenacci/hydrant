{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id,\n                   seq,\n                   payload,\n                   octet_length(payload::text) AS \"payload_bytes!\",\n                   content_hash,\n                   ingested_at,\n                   deleted_at\n              FROM record\n             WHERE source = $1\n               AND collection = $2\n               AND deleted_at IS NULL\n               AND seq > $3\n               AND payload @> $5\n             ORDER BY seq\n             LIMIT $4\n            ",

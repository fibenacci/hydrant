# Copy to .env for local development. .env is gitignored; this file is not.
#
#   cp .env.example .env
#   make db-up

# Connection string used by the Makefile targets, sqlx and the CLI.
DATABASE_URL=postgres://hydrant:hydrant@localhost:5433/hydrant

# Credentials the local container is initialised with. Changing these means
# changing DATABASE_URL to match.
POSTGRES_DB=hydrant
POSTGRES_USER=hydrant
POSTGRES_PASSWORD=hydrant

# Host port for the local database. 5433 avoids the usual collision with an
# existing PostgreSQL on 5432; change it freely and adjust DATABASE_URL to match.
HYDRANT_DB_PORT=5433

# --- service ---------------------------------------------------------------
# Every setting is read from the environment; there is no config file. A value
# prefixed with HYDRANT_ wins over the plain one.

# Address to listen on. 0.0.0.0:8080 is the default, which is what a container wants.
HYDRANT_LISTEN=127.0.0.1:8080

# tracing filter. RUST_LOG overrides it when something has to be debugged in place.
HYDRANT_LOG=info

# Secret that ingest tokens are hashed with. At least 32 characters, and not in
# the database on purpose: a dump without it yields no working credentials.
# Changing it invalidates every existing token, which is how a leak is handled.
HYDRANT_TOKEN_SECRET=change-me-to-something-long-and-random

# Directory of collection definitions, read at startup. Cache directives are
# declared per collection in those files, so there is no global s-maxage.
HYDRANT_SCHEMAS_DIR=schemas

# Apply pending migrations at startup. On by default.
HYDRANT_MIGRATE_ON_START=true

# Hard limit per database statement, in seconds. Bounds the worst case of a
# filter the planner cannot serve from an index.
HYDRANT_STATEMENT_TIMEOUT=5
